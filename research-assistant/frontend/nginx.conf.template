server {
    listen 80;
    server_name _;
    # Backend UPLOAD_MAX_MB defaults to 32 MiB. Keep one MiB for multipart
    # framing instead of silently accepting bodies the backend will reject.
    client_max_body_size 33m;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # BFF-style credential injection: the browser never receives the API
        # token. nginx adds it server-side for every proxied API request.
        proxy_set_header Authorization "Bearer ${API_AUTH_TOKEN}";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /ping {
        proxy_pass http://backend:8080/ping;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
