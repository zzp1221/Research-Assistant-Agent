    "/api/literature/search": {
      "get": {
        "operationId": "searchLiterature",
        "summary": "Search arXiv/OpenAlex/Crossref/GitHub/Semantic Scholar/PubMed/DBLP",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sources",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Comma-separated: arxiv,openalex,crossref,github,semanticscholar,pubmed,dblp"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["relevance", "citations", "year"],
              "default": "relevance"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          {
            "name": "year_from",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LiteratureResult"
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/literature/import": {
      "post": {
        "operationId": "importLiterature",
        "summary": "Import a paper by arXiv URL/ID, DOI or PDF URL (downloads PDF and metadata)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ref"
                ],
                "properties": {
                  "ref": {
                    "type": "string"
                  },
                  "attach": {
                    "type": "boolean",
                    "description": "Store the PDF as an upload for the caller (default true)"
                  },
                  "metadata_only": {
                    "type": "boolean",
                    "description": "Save metadata to the library without downloading the PDF"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imported metadata and upload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid reference"
          },
          "502": {
            "description": "Provider or download failure"
          }
        }
      }
    },
