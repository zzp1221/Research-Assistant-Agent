{
  "openapi": "3.1.0",
  "info": {
    "title": "Research Assistant API",
    "version": "2026.10",
    "description": "Plan creation, execution control, uploads, literature import and observability for the Research Assistant."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same host as the deployed backend"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "identityCookie": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      },
      "identityCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sa_uid"
      }
    },
    "schemas": {
      "PlanGraph": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "user_intent": {
            "type": "string"
          },
          "intent_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "in_progress",
              "awaiting_approval",
              "completed",
              "failed",
              "canceled"
            ]
          },
          "outcome": {
            "type": "string"
          },
          "paused": {
            "type": "boolean"
          },
          "run_trigger": {
            "type": "string",
            "enum": [
              "manual",
              "auto"
            ]
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "artifacts": {
            "type": "object"
          },
          "usage": {
            "type": "object"
          },
          "approval": {
            "type": "object"
          },
          "runtime_policy": {
            "type": "object"
          },
          "verification": {
            "$ref": "#/components/schemas/Verification"
          },
          "model_snapshot": {
            "type": "object"
          }
        }
      },
      "PlanEvent": {
        "type": "object",
        "properties": {
          "plan_id": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "format": "int64"
          },
          "event_type": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "task_status": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RuntimeAction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image_pull",
              "dependency_install",
              "dataset_download",
              "model_download",
              "gpu_use",
              "network_access",
              "system_package_install"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "expired",
              "canceled"
            ]
          },
          "title": {
            "type": "string"
          }
        }
      },
      "MissingRequirement": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        }
      },
      "Upload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          },
          "content_url": {
            "type": "string"
          },
          "deduplicated": {
            "type": "boolean"
          },
          "scan": {
            "type": "object"
          }
        }
      },
      "LiteratureResult": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "year": {
            "type": "integer"
          },
          "doi": {
            "type": "string"
          },
          "arxiv_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "pdf_url": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "missing_requirements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MissingRequirement"
            }
          }
        }
      },
      "Verification": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "inconclusive",
              "skipped"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "structural",
              "text",
              "visual",
              "none"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "verified_by": {
            "type": "object",
            "properties": {
              "profile_id": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "mode": {
                "type": "string"
              }
            }
          },
          "rubric_version": {
            "type": "string"
          },
          "image_sha256": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_ms": {
            "type": "integer"
          },
          "token_usage": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "integer"
              },
              "completion": {
                "type": "integer"
              },
              "estimated": {
                "type": "boolean"
              }
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "level",
          "verified"
        ]
      },
      "ModelProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "owner_id": {
            "type": "string",
            "description": "Empty string means a global profile"
          },
          "global": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "openai_compatible"
            ]
          },
          "base_url": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "api_key_masked": {
            "type": "string",
            "description": "Only the last four characters are ever returned"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "main",
                "vision",
                "fallback"
              ]
            }
          },
          "supports_vision": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "vision_probe_reason": {
            "type": "string"
          },
          "vision_probed_at": {
            "type": "string",
            "format": "date-time"
          },
          "timeout_seconds": {
            "type": "integer"
          },
          "max_output_tokens": {
            "type": "integer"
          },
          "context_window_tokens": {
            "type": "integer",
            "description": "Model context window used for prompt budgeting (default 128000)"
          },
          "prompt_price_per_1k": {
            "type": "number"
          },
          "completion_price_per_1k": {
            "type": "number"
          },
          "revision": {
            "type": "integer"
          },
          "bootstrap": {
            "type": "boolean"
          }
        }
      },
      "ModelProfileInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "api_key": {
            "type": "string",
            "description": "Write-only; empty on update keeps the existing secret"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supports_vision": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "timeout_seconds": {
            "type": "integer"
          },
          "max_output_tokens": {
            "type": "integer"
          },
          "context_window_tokens": {
            "type": "integer",
            "description": "Model context window used for prompt budgeting (default 128000)"
          },
          "prompt_price_per_1k": {
            "type": "number"
          },
          "completion_price_per_1k": {
            "type": "number"
          },
          "global": {
            "type": "boolean",
            "description": "Requires ADMIN_TOKEN"
          }
        },
        "required": [
          "name",
          "base_url",
          "model",
          "api_key"
        ]
      },
      "ModelRouting": {
        "type": "object",
        "properties": {
          "owner_id": {
            "type": "string"
          },
          "main_profile_id": {
            "type": "string"
          },
          "vision_profile_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallback_profile_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "parameters": {
      "PlanID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "TaskID": {
        "name": "taskId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "AfterSeq": {
        "name": "after_seq",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness and dependency health (no provider credentials)",
        "security": [],
        "responses": {
          "200": {
            "description": "Health document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Current server-issued principal",
        "responses": {
          "200": {
            "description": "Identity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string"
                    },
                    "session_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/plan": {
      "post": {
        "operationId": "createPlan",
        "summary": "Create an execution plan from an intent",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "intent"
                ],
                "properties": {
                  "intent": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 8
                  },
                  "runtime_permission_mode": {
                    "type": "string",
                    "enum": [
                      "confirm_important",
                      "full_access"
                    ]
                  },
                  "runtime_permission_acknowledged": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plan created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plan_graph": {
                      "$ref": "#/components/schemas/PlanGraph"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid intent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited or active plan quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans": {
      "get": {
        "operationId": "listPlans",
        "summary": "List the caller's plans",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "session_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Plan summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plans": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "next_cursor": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/plans/{id}": {
      "get": {
        "operationId": "getPlan",
        "summary": "Read one plan",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          }
        ],
        "responses": {
          "200": {
            "description": "Plan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plan_graph": {
                      "$ref": "#/components/schemas/PlanGraph"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "delete": {
        "operationId": "deletePlan",
        "summary": "Delete one plan",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "409": {
            "description": "Plan is running"
          }
        }
      }
    },
    "/api/plans/{id}/execute": {
      "post": {
        "operationId": "executePlan",
        "summary": "Start or resume plan execution",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "trigger": {
                    "type": "string",
                    "enum": [
                      "manual",
                      "auto"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Execution started"
          },
          "409": {
            "description": "Plan cannot start"
          }
        }
      }
    },
    "/api/plans/{id}/pause": {
      "post": {
        "operationId": "pausePlan",
        "summary": "Pause dispatching new tasks",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          }
        ],
        "responses": {
          "200": {
            "description": "Paused"
          },
          "409": {
            "description": "Plan cannot be paused"
          }
        }
      }
    },
    "/api/plans/{id}/resume": {
      "post": {
        "operationId": "resumePlan",
        "summary": "Resume a paused plan",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          }
        ],
        "responses": {
          "200": {
            "description": "Resumed"
          },
          "409": {
            "description": "Plan cannot be resumed"
          }
        }
      }
    },
    "/api/plans/{id}/cancel": {
      "post": {
        "operationId": "cancelPlan",
        "summary": "Cancel a plan and release its sandboxes",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          }
        ],
        "responses": {
          "200": {
            "description": "Canceled"
          },
          "409": {
            "description": "Plan is terminal"
          }
        }
      }
    },
    "/api/plans/{id}/approve": {
      "post": {
        "operationId": "approvePlan",
        "summary": "Approve a plan that requires human approval",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          }
        ],
        "responses": {
          "200": {
            "description": "Approved"
          },
          "409": {
            "description": "Approval not allowed"
          }
        }
      }
    },
    "/api/plans/{id}/tasks/{taskId}/run": {
      "post": {
        "operationId": "runFromNode",
        "summary": "Rewind from a node and re-run the plan",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          },
          {
            "$ref": "#/components/parameters/TaskID"
          }
        ],
        "responses": {
          "202": {
            "description": "Rewound and started"
          },
          "409": {
            "description": "Plan is running"
          }
        }
      }
    },
    "/api/plans/{id}/events": {
      "get": {
        "operationId": "listPlanEvents",
        "summary": "Incremental plan event log",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          },
          {
            "$ref": "#/components/parameters/AfterSeq"
          }
        ],
        "responses": {
          "200": {
            "description": "Events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PlanEvent"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/plans/{id}/stream": {
      "get": {
        "operationId": "streamPlanEvents",
        "summary": "Server-sent events with Last-Event-ID/after_seq resume",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          },
          {
            "$ref": "#/components/parameters/AfterSeq"
          },
          {
            "name": "ticket",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "text/event-stream"
          }
        }
      }
    },
    "/api/plans/{id}/stream-ticket": {
      "get": {
        "operationId": "planStreamTicket",
        "summary": "Issue a short-lived SSE ticket",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticket": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/plans/{id}/runtime-actions": {
      "get": {
        "operationId": "listRuntimeActions",
        "summary": "List runtime approval requests",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          }
        ],
        "responses": {
          "200": {
            "description": "Actions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "runtime_actions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RuntimeAction"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/plans/{id}/runtime-actions/{actionId}/decision": {
      "post": {
        "operationId": "decideRuntimeAction",
        "summary": "Approve or reject a runtime action",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          },
          {
            "name": "actionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "decision"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approve",
                      "reject"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision applied"
          },
          "409": {
            "description": "Expired or terminal"
          }
        }
      }
    },
    "/api/plans/{id}/export": {
      "get": {
        "operationId": "exportPlan",
        "summary": "Export a reproducible plan package",
        "parameters": [
          {
            "$ref": "#/components/parameters/PlanID"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "md",
                "json",
                "zip"
              ],
              "default": "md"
            }
