# Copy to .env and replace each token with a random secret.
# docker compose uses these for the API, backend <-> sandbox and backend <-> optimizer boundaries.
SANDBOX_API_TOKEN=replace-with-a-random-internal-token
RESEARCH_OPTIMIZER_API_TOKEN=replace-with-a-random-internal-token
# Required for Docker Compose: backend API and the prebuilt frontend both use it.
API_AUTH_TOKEN=replace-with-a-random-api-token
SANDBOX_IMAGE_ALLOWLIST=python:3.9-bullseye,python:3.11-bullseye

# Optional override for advanced deployments. Compose bakes API_AUTH_TOKEN into
# the frontend build automatically.
VITE_API_AUTH_TOKEN=

# Runtime model profiles (see docs/design/runtime-model-config-and-visual-verification.md).
# 32-byte base64 key used to seal per-user API keys; profile saving fails closed without it.
MODEL_PROFILE_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
# Comma-free operator token that may create/modify global model profiles.
ADMIN_TOKEN=replace-with-an-admin-token
# Vision verification tuning (defaults shown).
VISION_MAX_EDGE_PX=1280
VISION_MAX_IMAGES=4
VISION_TIMEOUT_SECONDS=120
FEATURE_VISION_VERIFICATION=true
# Only enable for local/container testing with a private mock provider.
ALLOW_PRIVATE_MODEL_ENDPOINTS=false
