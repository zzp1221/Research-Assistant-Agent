# Copy to .env and replace both values with random secrets.
# docker compose uses these for the backend <-> sandbox and backend <-> optimizer boundaries.
SANDBOX_API_TOKEN=replace-with-a-random-internal-token
RESEARCH_OPTIMIZER_API_TOKEN=replace-with-a-random-internal-token
SANDBOX_IMAGE_ALLOWLIST=python:3.9-bullseye,python:3.11-bullseye

# Optional: bake the frontend bearer token at image build time.
# Leave empty for loopback/local development; only use with trusted static hosting.
VITE_API_AUTH_TOKEN=
