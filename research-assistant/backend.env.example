# Copy this file to backend.env and fill in your values.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.ai-pixel.online/v1
OPENAI_MODEL_NAME=deepseek-v4.1-flash-1017

# Optional hybrid intent router. Compose points this at the intent-recognition service.
INTENT_SERVICE_URL=http://localhost:18000
INTENT_ROUTER_MODE=hybrid
INTENT_LLM_CONFIDENCE_THRESHOLD=0.65
INTENT_CLIENT_TIMEOUT_SECONDS=15
SANDBOX_URL=http://localhost:8082
OPEN_SANDBOX_URL=http://localhost:8081
ENABLE_OPENSANDBOX_FALLBACK=false
# Optional: use a prebuilt runtime image for repeatable paper smoke tests.
SANDBOX_DEFAULT_IMAGE=python:3.9-bullseye

# Runtime persistence and governance
PLAN_STORE_PATH=./data/plans.json
PLAN_MAX_TASK_ATTEMPTS=100
PLAN_MAX_DURATION_SECONDS=2100
REQUIRE_PLAN_APPROVAL=false

# Optional Python learning plane. Leave URL empty to use deterministic FIFO.
RESEARCH_OPTIMIZER_URL=http://localhost:8090
RESEARCH_OPTIMIZER_API_TOKEN=replace-with-a-random-internal-token

# API boundary. Docker Compose overrides these with API_AUTH_TOKEN from .env
# and forces REQUIRE_API_AUTH=true. Keep them empty/false only for trusted
# local development outside Compose.
API_AUTH_TOKEN=
REQUIRE_API_AUTH=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PDF_PROXY_MAX_MB=32
# Document intelligence (N-07)
PDF_OCR_MAX_PAGES=5
PDF_OCR_TIMEOUT_SECONDS=60
PDF_OCR_LANG=eng+chi_sim
PDF_OCR_MIN_TEXT_CHARS=20
# Empty keeps <PLAN_STORE_PATH directory>/document-cache.
DOCUMENT_CACHE_DIR=
# Literature library (N-04); empty keeps <PLAN_STORE_PATH directory>/literature-library.
LITERATURE_LIBRARY_DIR=
LITERATURE_MAX_RETRIES=2
# Per-provider deadline inside a multi-provider search.
LITERATURE_PROVIDER_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_MB=2
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_RESPECT_ROBOTS=true
WEB_FETCH_CACHE_TTL_SECONDS=3600
# Only for local/container tests with a private web server.
ALLOW_PRIVATE_WEB_FETCH=false
UPLOAD_ROOT=./data/uploads
UPLOAD_MAX_MB=32

# Backend-only hidden labels/evaluators for Benchmark Agent. Do not mount this
# path into docker-sandbox or experiment containers.
BENCHMARK_PRIVATE_ROOT=./data/private-benchmarks

# Internal sandbox authentication and container policy
SANDBOX_API_TOKEN=replace-with-a-random-internal-token
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_PIDS_LIMIT=256
SANDBOX_NETWORK_MODE=bridge
SANDBOX_WORKSPACE_ROOTS=/tmp
# Optional comma-separated image prefixes, for example: python:3.9,registry.example/research/
# Docker Compose defaults this to python:3.9-bullseye.
SANDBOX_IMAGE_ALLOWLIST=python:3.9-bullseye,python:3.11-bullseye
# Optional PyPI mirror used by sandbox pip installs.
PIP_INDEX_URL=
SANDBOX_CONTAINER_USER=
SANDBOX_READ_ONLY_ROOT=false

# Model output is omitted from process logs by default.
LOG_MODEL_OUTPUT=false


# Runtime model profiles (design: docs/design/runtime-model-config-and-visual-verification.md)
# MODEL_PROFILE_DIR defaults to "<PLAN_STORE_PATH>.model-profiles".
MODEL_PROFILE_DIR=
# 32-byte base64 key sealing per-user API keys. Profile saving fails closed when empty.
MODEL_PROFILE_ENCRYPTION_KEY=
# Operator token allowed to create/modify global profiles.
ADMIN_TOKEN=
MODEL_PROFILE_MAX_PER_USER=10
MODEL_PROBE_RATE_LIMIT_SECONDS=5
VISION_MAX_EDGE_PX=1280
VISION_MAX_IMAGES=4
VISION_TIMEOUT_SECONDS=120
VISION_MIN_EDGE_PX=32
FEATURE_VISION_VERIFICATION=true
# Only for local/container tests with a private mock provider.
ALLOW_PRIVATE_MODEL_ENDPOINTS=false
